#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

tag="${1:-}"
dry_run="${2:-}"

if (( $# > 2 )); then
  echo "Usage: bin/npm-release {api|card}-v<version> [--dry-run]" >&2
  exit 2
fi

case "$tag" in
  api-v*)
    workspace=@shirabe-org/api
    manifest=packages/api/package.json
    prefix=api-v
    ;;
  card-v*)
    workspace=@shirabe-org/card
    manifest=packages/card/package.json
    prefix=card-v
    ;;
  *)
    echo "Usage: bin/npm-release {api|card}-v<version> [--dry-run]" >&2
    exit 2
    ;;
esac

if [[ -n "$dry_run" && "$dry_run" != "--dry-run" ]]; then
  echo "Usage: bin/npm-release {api|card}-v<version> [--dry-run]" >&2
  exit 2
fi

version=$(node -p "require('./$manifest').version")
expected="${prefix}${version}"
if [[ "$tag" != "$expected" ]]; then
  echo "Release tag $tag does not match $workspace@$version; expected $expected." >&2
  exit 1
fi

if published=$(npm view "$workspace@$version" version 2>/dev/null); then
  if [[ "$published" != "$version" ]]; then
    echo "Registry returned an unexpected version for $workspace@$version: $published" >&2
    exit 1
  fi
  echo "$workspace@$version is already published."
  exit 0
fi

if [[ "$workspace" == "@shirabe-org/card" ]]; then
  api_version=$(node -p "require('./$manifest').dependencies['@shirabe-org/api']")
  if ! published_api=$(npm view "@shirabe-org/api@$api_version" version 2>/dev/null); then
    echo "@shirabe-org/card requires unpublished @shirabe-org/api@$api_version." >&2
    exit 1
  fi
  if [[ "$published_api" != "$api_version" ]]; then
    echo "@shirabe-org/card requires unpublished @shirabe-org/api@$api_version." >&2
    exit 1
  fi
fi

bin/package-check

publish=(npm publish --workspace "$workspace")
if [[ "$dry_run" == "--dry-run" ]]; then
  publish+=(--dry-run)
fi
"${publish[@]}"
