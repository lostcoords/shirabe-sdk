#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

source=${1:-https://shirabe.org/openapi.yaml}
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT

case "$source" in
  http://*|https://*) curl --fail --location --silent --show-error "$source" > "$temporary" ;;
  *) cp "$source" "$temporary" ;;
esac
node script/import-openapi.mjs "$temporary"
npm install --package-lock-only --ignore-scripts --no-audit --no-fund

npm run codegen --workspace @shirabe-org/api
npm run check --workspace @shirabe-org/api
